---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="cs">
	<head>
		<BaseHead title={`Zápisky | ${SITE_TITLE}`} description="Poznámky, zkušenosti a témata, která stojí za sdílení." />
		<style>
			main { width: min(100% - 3rem, 1060px); max-width: none; padding-top: 5rem; padding-bottom: 6rem; }
			.eyebrow { color: #a05e39; font-size: .72rem; font-weight: 700; letter-spacing: .16em; }
			h1 { font-size: clamp(2.5rem, 6vw, 4.5rem); letter-spacing: -.06em; }
			.posts { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; padding: 0; list-style: none; }
			.posts li a { color: inherit; text-decoration: none; }
			.posts img { width: 100%; aspect-ratio: 2 / 1; object-fit: cover; }
			.posts h2 { margin: .8rem 0 .2rem; font-size: 1.4rem; }
			.date { color: #68716c; }
			.empty-state { max-width: 650px; margin: 3rem auto 0; text-align: center; }
			.empty-state p:not(.eyebrow) { color: #59615d; }
			.empty-state a { color: #243b35; font-weight: 700; }
			@media (max-width: 650px) { main { width: min(100% - 2rem, 1060px); } .posts { grid-template-columns: 1fr; } }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<p class="eyebrow">ZÁPISKY A POSTŘEHY</p>
			<h1>Myšlenky, které stojí za sdílení.</h1>
			{posts.length ? (
				<ul class="posts">
					{posts.map((post) => <li><a href={`/blog/${post.id}/`}>
						{post.data.heroImage && <img src={post.data.heroImage} alt="" />}
						<h2>{post.data.title}</h2><p>{post.data.description}</p><p class="date"><FormattedDate date={post.data.pubDate} /></p>
					</a></li>)}
				</ul>
			) : (
				<div class="empty-state"><p>První text právě vzniká. Brzy tu najdeš poznámky, zkušenosti a témata, která mě zajímají.</p><a href="/about/">Zatím se můžeš dozvědět něco o mně →</a></div>
			)}
		</main>
		<Footer />
	</body>
</html>
