---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const areas = [
	{
		id: 'weby',
		number: '01',
		label: 'WEBY · FE + BE',
		title: 'API katalog a Schema Registry',
		intro: 'Funkcionalitu nejdřív ověřím akceptačně. Potom důležité scénáře převedu do automatických AT testů a regrese.',
		details: 'Na API katalogu pokrývám FE i BE: formuláře, stavy, validace, oprávnění, registraci a změny API. Backend Schema Registry testuji přes API tak, že scénáře vystupují jako klient a ověřují odpovědi i chybové stavy.',
	},
	{
		id: 'ci-cd',
		number: '02',
		label: 'CI/CD',
		title: 'Testování buildů a delivery pipeline',
		intro: 'Pipeline musí doručit správný výsledek, nejen zelené kolečko.',
		details: 'Ověřuji generování, validaci a publikaci artefaktů, registraci API, metadata i čitelné chování při chybě. Zahrnuji také regresní kontroly po změnách a upgradech.',
	},
	{
		id: 'sdk',
		number: '03',
		label: 'SDK · JAVA + .NET',
		title: 'Klientské knihovny v reálných scénářích',
		intro: 'SDK testuji tak, jak ho používá aplikace: přes volání, odpovědi a občas i ne zrovna přívětivou chybu.',
		details: 'Pracuji se scénáři pro Java a .NET SDK přes REST, SOAP i messaging. Sleduji zpracování chyb a také průchod trace ID a spanů mezi navazujícími službami.',
	},
];
---

<!doctype html>
<html lang="cs">
	<head><BaseHead title="S čím pomohu | Rostislav Šlechta" description="Testování webových aplikací, CI/CD pipeline a Java/.NET SDK." /></head>
	<body>
		<Header />
		<main class="services-page">
			<header class="page-intro">
				<p class="eyebrow">JAK POMÁHÁM TÝMŮM</p>
				<h1>Testuji tři vrstvy.<br /><span>Od webu po SDK.</span></h1>
				<p class="lead">Jasné rozdělení, srozumitelný výsledek: weby (FE/BE), CI/CD pipeline a klientská SDK pro Javu a .NET.</p>
			</header>

			<div class="service-list">
				{areas.map((area) => <article class="service-item" id={area.id}>
					<div class="service-number">{area.number}</div>
					<div class="service-body">
						<p class="service-label">{area.label}</p>
						<h2>{area.title}</h2>
						<p class="intro">{area.intro}</p>
						<p>{area.details}</p>
						<a href={'/reference/#' + area.id}>Příklady z praxe <span aria-hidden="true">↗</span></a>
					</div>
				</article>)}
			</div>

			<section class="method">
				<div>
					<p class="eyebrow">U WEBŮ: OD ZMĚNY K REGRESI</p>
					<h2>Nejdřív zjistit, jestli změna dává smysl. Pak hlídat, aby to tak zůstalo.</h2>
				</div>
				<div class="method-flow" aria-label="Akceptace, automatizované testy, regrese">
					<span><b>01</b> Akceptace</span><i aria-hidden="true">→</i>
					<span><b>02</b> AT scénáře</span><i aria-hidden="true">→</i>
					<span><b>03</b> Regrese</span>
				</div>
			</section>

			<section class="deliverables">
				<p class="eyebrow">CO ZŮSTANE PO TESTU</p>
				<h2>Výsledek, se kterým se dá pracovat.</h2>
				<div class="deliverable-grid">
					<p><b>Scénáře</b><br />Co jsme ověřili a proč.</p>
					<p><b>Automatizace</b><br />Opakovatelné kontroly tam, kde dávají smysl.</p>
					<p><b>Nálezy</b><br />Jasný popis, reprodukce a souvislosti.</p>
					<p><b>Rozhodnutí</b><br />Co je pokryté a jaké riziko zbývá.</p>
				</div>
			</section>

			<section class="cta"><div><p class="eyebrow">MÁTE KONKRÉTNÍ VÝZVU?</p><h2>Proberme ji dřív, než se z ní stane incident.</h2></div><a class="button" href="/kontakt/">Domluvit se <span aria-hidden="true">↗</span></a></section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.services-page { width: min(100% - 3rem, 1000px); max-width: none; padding-top: clamp(4rem, 9vw, 7rem); padding-bottom: 5rem; }
	.eyebrow { margin: 0 0 .8rem; color: #a05e39; font-size: .7rem; font-weight: 800; letter-spacing: .16em; }
	.page-intro { max-width: 800px; margin-bottom: 3rem; }
	h1 { margin: 0; font-size: clamp(2.6rem, 6vw, 5rem); line-height: 1.02; letter-spacing: -.06em; }
	h1 span { color: #a05e39; }
	.lead { max-width: 680px; color: #59615d; font-size: 1.2rem; line-height: 1.65; }
	.service-item { display: grid; grid-template-columns: 75px 1fr; gap: 1.5rem; padding: 2rem 0; border-top: 1px solid #d9ddd7; scroll-margin-top: 2rem; }
	.service-number { color: #a05e39; font-size: .8rem; font-weight: 800; letter-spacing: .1em; }
	.service-label { margin: 0 0 .45rem; color: #a05e39; font-size: .65rem; font-weight: 800; letter-spacing: .13em; }
	.service-item h2 { margin: 0 0 .35rem; color: #243b35; font-size: 1.55rem; letter-spacing: -.035em; }
	.service-item p { max-width: 750px; margin: .5rem 0; color: #59615d; font-size: .98rem; line-height: 1.7; }
	.service-item .intro { color: #243b35; font-weight: 700; }
	.service-item a { display: inline-block; margin-top: .5rem; color: #243b35; font-size: .88rem; font-weight: 700; text-underline-offset: .2em; }
	.method { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 2rem; margin-top: 2.5rem; padding: 2rem; background: #243b35; color: #fff; }
	.method .eyebrow { color: #e4a986; }
	.method h2 { max-width: 520px; margin: 0; font-size: clamp(1.4rem, 3vw, 2rem); letter-spacing: -.04em; }
	.method-flow { display: grid; gap: .65rem; }
	.method-flow span { display: flex; align-items: center; gap: .65rem; font-size: .85rem; font-weight: 700; }
	.method-flow b { display: grid; width: 1.6rem; height: 1.6rem; place-items: center; border-radius: 50%; color: #243b35; background: #e4a986; font-size: .65rem; }
	.method-flow i { margin-left: .8rem; color: #e4a986; font-size: .8rem; line-height: .3; }
	.deliverables { margin-top: 3rem; padding: 2.5rem; background: #e9ece6; }
	.deliverables h2, .cta h2 { margin: 0; font-size: clamp(1.7rem, 4vw, 2.4rem); letter-spacing: -.04em; }
	.deliverable-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-top: 1.5rem; }
	.deliverable-grid p { margin: 0; color: #59615d; font-size: .88rem; line-height: 1.55; }
	.deliverable-grid b { color: #243b35; }
	.cta { display: flex; align-items: center; justify-content: space-between; gap: 2rem; margin-top: 3rem; padding: 2.5rem; background: #f0e6df; }
	.button { display: inline-flex; flex: 0 0 auto; gap: 1rem; padding: .85rem 1.2rem; color: #fff; background: #243b35; text-decoration: none; font-weight: 700; }
	.button:hover { color: #fff; background: #36564d; }
	@media (max-width: 720px) { .method { grid-template-columns: 1fr; } .method-flow { display: flex; align-items: center; flex-wrap: wrap; gap: .5rem; } .method-flow i { margin-left: 0; } .deliverable-grid { grid-template-columns: repeat(2, 1fr); } }
	@media (max-width: 560px) { .services-page { width: min(100% - 2rem, 1000px); } .service-item { grid-template-columns: 42px 1fr; gap: 1rem; } .deliverables, .cta, .method { padding: 1.5rem; } .cta { align-items: flex-start; flex-direction: column; } }
</style>
