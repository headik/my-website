---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const areas = [
	{
		id: 'weby',
		number: '01',
		label: 'WEBOVÉ APLIKACE · FE + BE',
		title: 'API katalog a Schema Registry',
		intro: 'Funkčnost změn ověřuji akceptačně. Do automatizovaných testů (AT) a regresní sady zařazuji scénáře podle rizika, četnosti opakování a náročnosti údržby.',
		details: 'API katalog testuji na FE i BE, mimo jiné formuláře, stavy, validace, oprávnění, registraci a změny API. Backend Schema Registry ověřuji přes API scénáři simulujícími klienta. U E2E napříč systémy zohledňuji síťové prostupy, oprávnění a bezpečnostní podmínky.',
	},
	{
		id: 'ci-cd',
		number: '02',
		label: 'CI/CD',
		title: 'Testování buildů a delivery pipeline',
		intro: 'Ověřuji průchod pipeline od buildu a validace po registraci a publikaci artefaktu.',
		details: 'Kontroluji výstupy jednotlivých kroků, metadata, chybové stavy a regresní chování po změnách nebo upgradech.',
	},
	{
		id: 'sdk',
		number: '03',
		label: 'JAVA A .NET SDK',
		title: 'Testování klientských knihoven',
		intro: 'Ověřuji chování SDK v aplikacích a navazujících službách.',
		details: 'Testuji scénáře při volání REST a SOAP služeb i při zprávové komunikaci, včetně zpracování chyb a předávání trace ID a spanů mezi službami.',
	},
];
---

<!doctype html>
<html lang="cs">
	<head><BaseHead title="Oblasti testování | Rostislav Šlechta" description="Testování webových aplikací, CI/CD pipeline a Java/.NET SDK." /></head>
	<body>
		<Header />
		<main class="services-page">
			<header class="page-intro">
				<p class="eyebrow">ODBORNÉ ZAMĚŘENÍ</p>
				<h1>Webové aplikace,<br /><span>CI/CD pipeline a SDK.</span></h1>
				<p class="lead">Zaměřuji se na API katalog a Schema Registry, CI/CD pipeline a Java/.NET SDK.</p>
			</header>

			<div class="service-list">
				{areas.map((area) => <article class="service-item" id={area.id}>
					<div class="service-number">{area.number}</div>
					<div class="service-body">
						<p class="service-label">{area.label}</p>
						<h2>{area.title}</h2>
						<p class="intro">{area.intro}</p>
						<p>{area.details}</p>
						<a href={'/reference/#' + area.id}>Podrobnosti o praxi <span aria-hidden="true">↗</span></a>
					</div>
				</article>)}
			</div>

			<section class="method">
				<div>
					<p class="eyebrow">PŘÍSTUP K AUTOMATIZACI</p>
					<h2>Automatizaci volím podle rizika a přínosu scénáře.</h2>
					<p>Zohledňuji také četnost opakování a náklady na údržbu. U end-to-end (E2E) testů přes více systémů řeším síťové prostupy, oprávnění a bezpečnostní podmínky.</p>
				</div>
				<div class="method-flow" aria-label="Akceptace, výběr AT scénářů, regrese">
					<span><b>01</b> Akceptace</span><i aria-hidden="true">→</i>
					<span><b>02</b> Výběr AT</span><i aria-hidden="true">→</i>
					<span><b>03</b> Regrese</span>
				</div>
			</section>

			<section class="deliverables">
				<p class="eyebrow">VÝSTUPY TESTOVÁNÍ</p>
				<h2>Informace pro rozhodnutí o kvalitě a riziku.</h2>
				<div class="deliverable-grid">
					<p><b>Rozsah</b><br />Ověřované scénáře a předpoklady.</p>
					<p><b>Výsledky</b><br />Stav provedených kontrol.</p>
					<p><b>Nálezy</b><br />Reprodukční kroky a technický kontext.</p>
					<p><b>Rizika</b><br />Pokrytá oblast a otevřené otázky.</p>
				</div>
			</section>

			<section class="cta"><div><p class="eyebrow">KONTAKT</p><h2>V případě zájmu rád doplním další informace.</h2></div><a class="button" href="/kontakt/">Kontaktovat <span aria-hidden="true">↗</span></a></section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.services-page { width: min(100% - 3rem, 1000px); max-width: none; padding-top: clamp(4rem, 9vw, 7rem); padding-bottom: 5rem; }
	.eyebrow { margin: 0 0 .8rem; color: #a05e39; font-size: .7rem; font-weight: 800; letter-spacing: .16em; }
	.page-intro { max-width: 800px; margin-bottom: 3rem; }
	h1 { margin: 0; font-size: clamp(2.6rem, 6vw, 5rem); line-height: 1.02; letter-spacing: -.06em; }
	h1 span { color: #a05e39; }
	.lead { max-width: 680px; color: #59615d; font-size: 1.2rem; line-height: 1.65; }
	.service-item { display: grid; grid-template-columns: 75px 1fr; gap: 1.5rem; padding: 2rem 0; border-top: 1px solid #d9ddd7; scroll-margin-top: 2rem; }
	.service-number { color: #a05e39; font-size: .8rem; font-weight: 800; letter-spacing: .1em; }
	.service-label { margin: 0 0 .45rem; color: #a05e39; font-size: .65rem; font-weight: 800; letter-spacing: .13em; }
	.service-item h2 { margin: 0 0 .35rem; color: #243b35; font-size: 1.55rem; letter-spacing: -.035em; }
	.service-item p { max-width: 750px; margin: .5rem 0; color: #59615d; font-size: .98rem; line-height: 1.7; }
	.service-item .intro { color: #243b35; font-weight: 700; }
	.service-item a { display: inline-block; margin-top: .5rem; color: #243b35; font-size: .88rem; font-weight: 700; text-underline-offset: .2em; }
	.method { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 2rem; margin-top: 2.5rem; padding: 2rem; background: #243b35; color: #fff; }
	.method .eyebrow { color: #e4a986; }
	.method h2 { max-width: 520px; margin: 0; font-size: clamp(1.4rem, 3vw, 2rem); letter-spacing: -.04em; }
	.method > div > p:last-child { max-width: 560px; margin: .8rem 0 0; color: #d3ddd7; font-size: .92rem; line-height: 1.6; }
	.method-flow { display: grid; gap: .65rem; }
	.method-flow span { display: flex; align-items: center; gap: .65rem; font-size: .85rem; font-weight: 700; }
	.method-flow b { display: grid; width: 1.6rem; height: 1.6rem; place-items: center; border-radius: 50%; color: #243b35; background: #e4a986; font-size: .65rem; }
	.method-flow i { margin-left: .8rem; color: #e4a986; font-size: .8rem; line-height: .3; }
	.method-note { margin: 1rem 0 0; padding: .7rem .85rem; color: #59615d; background: #e9ece6; font-size: .78rem; line-height: 1.55; }
	.deliverables { margin-top: 3rem; padding: 2.5rem; background: #e9ece6; }
	.deliverables h2, .cta h2 { margin: 0; font-size: clamp(1.7rem, 4vw, 2.4rem); letter-spacing: -.04em; }
	.deliverable-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-top: 1.5rem; }
	.deliverable-grid p { margin: 0; color: #59615d; font-size: .88rem; line-height: 1.55; }
	.deliverable-grid b { color: #243b35; }
	.cta { display: flex; align-items: center; justify-content: space-between; gap: 2rem; margin-top: 3rem; padding: 2.5rem; background: #f0e6df; }
	.button { display: inline-flex; flex: 0 0 auto; gap: 1rem; padding: .85rem 1.2rem; color: #fff; background: #243b35; text-decoration: none; font-weight: 700; }
	.button:hover { color: #fff; background: #36564d; }
	@media (max-width: 720px) { .method { grid-template-columns: 1fr; } .method-flow { display: flex; align-items: center; flex-wrap: wrap; gap: .5rem; } .method-flow i { margin-left: 0; } .deliverable-grid { grid-template-columns: repeat(2, 1fr); } }
	.eyebrow, h1 span, .service-number, .service-label { color: var(--accent); }.lead, .service-item p, .deliverable-grid p { color: var(--muted); }.service-item, .focus-strip span { border-color: var(--line); }.service-item h2, .service-item .intro, .service-item a, .deliverable-grid b { color: var(--paper); }.method { border: 1px solid rgba(189,164,255,.35); background: #101d2b; }.method .eyebrow, .method-flow i { color: var(--violet); }.method h2 { color: var(--paper); }.method > div > p:last-child { color: var(--muted); }.method-flow b { color: #101d2b; background: var(--violet); }.deliverables { border: 1px solid var(--line); background: rgba(16,36,49,.65); }.deliverables h2 { color: var(--paper); }.cta { background: var(--accent); }.cta h2 { color: #08221b; }.cta .eyebrow { color: #235c4c; }.button { border-radius: 999px; background: #0b2531; }.button:hover { background: #183848; }
	@media (max-width: 560px) { .services-page { width: min(100% - 2rem, 1000px); } .service-item { grid-template-columns: 42px 1fr; gap: 1rem; } .deliverables, .cta, .method { padding: 1.5rem; } .cta { align-items: flex-start; flex-direction: column; } }
</style>
