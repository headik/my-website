---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

const email = 'rosta.slechta@gmail.com';
const subject = encodeURIComponent('Spolupráce v testování');
---

<!doctype html>
<html lang="cs">
	<head><BaseHead title={`Kontakt | ${SITE_TITLE}`} description="Kontakt na Rostislava Šlechtu ohledně testování, pracovních příležitostí nebo spolupráce." /></head>
	<body>
		<Header />
		<main class="contact-page">
			<p class="eyebrow">KONTAKT</p>
			<h1>Kontakt</h1>
			<p class="lead">Pro pracovní nabídky, odborné dotazy nebo možnosti spolupráce mi napište e-mailem.</p>
			<a class="email-card" href={`mailto:${email}?subject=${subject}`}>
				<span class="email-label">E-MAIL</span>
				<strong>{email}</strong>
				<span class="email-arrow" aria-hidden="true">↗</span>
			</a>
			<p class="contact-note">Rád doplním informace o svých zkušenostech a zaměření.</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.contact-page { width: min(100% - 3rem, 850px); max-width: none; min-height: 62vh; padding-top: clamp(5rem, 12vw, 9rem); padding-bottom: 6rem; }
	.eyebrow { color: #a05e39; font-size: .7rem; font-weight: 800; letter-spacing: .16em; }
	h1 { max-width: 800px; font-size: clamp(2.8rem, 7vw, 5.5rem); line-height: 1; letter-spacing: -.06em; }
	.lead { max-width: 620px; margin: 1.5rem 0 2rem; color: #59615d; font-size: 1.2rem; }
	.email-card { display: flex; align-items: center; justify-content: space-between; gap: 1rem; max-width: 560px; padding: 1.3rem 1.5rem; border: 1px solid #d9ddd7; color: #243b35; background: #fffefa; text-decoration: none; }
	.email-card:hover { border-color: #a05e39; box-shadow: 6px 6px 0 #e9ece6; }
	.email-label { color: #a05e39; font-size: .65rem; font-weight: 800; letter-spacing: .12em; }
	.email-card strong { flex: 1; font-size: 1.05rem; }
	.email-arrow { font-size: 1.2rem; }
	.contact-note { max-width: 560px; margin-top: 1rem; color: #79817d; font-size: .85rem; }
	.eyebrow, .email-label { color: var(--accent); }.lead, .contact-note { color: var(--muted); }.email-card { border-color: rgba(139,255,207,.35); border-radius: 14px; color: var(--paper); background: rgba(16,36,49,.7); }.email-card:hover { border-color: var(--accent); box-shadow: 8px 8px 0 rgba(139,255,207,.15); }
	@media (max-width: 600px) { .contact-page { width: min(100% - 2rem, 850px); } .email-card { flex-wrap: wrap; } .email-card strong { flex-basis: calc(100% - 2rem); order: 1; } .email-arrow { order: 2; } }
</style>
