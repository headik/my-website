---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="cs">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="intro" aria-labelledby="intro-title">
				<p class="eyebrow">OSOBNÍ WEB · MÍSTO PRO NÁPADY A PRÁCI</p>
				<h1 id="intro-title">Ahoj, jsem <span>Josef.</span><br />Těší mě, že jsi tady.</h1>
				<p class="lead">
					Tohle je můj osobní prostor. Najdeš tu projekty, kterým věnuji čas, témata, která mě zajímají,
					a pár poznámek z cesty.
				</p>
				<div class="actions">
					<a class="button primary" href="/about/">Poznej mě <span aria-hidden="true">↗</span></a>
					<a class="text-link" href="/blog/">Přečti si zápisky <span aria-hidden="true">→</span></a>
				</div>
			</section>

			<section class="focus" aria-label="Co tu najdeš">
				<div class="focus-heading">
					<p class="eyebrow">TŘI OKRUHY</p>
					<h2>Co je pro mě důležité</h2>
				</div>
				<div class="cards">
					<article class="card">
						<span class="card-number">01</span>
						<h3>Práce, která má smysl</h3>
						<p>Projekty, spolupráce a zkušenosti, na které jsem hrdý. Tady postupně představím, čemu se věnuji.</p>
					</article>
					<article class="card">
						<span class="card-number">02</span>
						<h3>Zvědavost v praxi</h3>
						<p>Nové myšlenky stojí za to zkoušet. Baví mě učit se, hledat souvislosti a sdílet, co funguje.</p>
					</article>
					<article class="card">
						<span class="card-number">03</span>
						<h3>Poznámky na cestu</h3>
						<p>Krátké postřehy a delší texty o tématech, ke kterým se rád vracím.</p>
					</article>
				</div>
			</section>

			<section class="closing">
				<p class="eyebrow">ZAČNĚME TADY</p>
				<h2>Každý dobrý příběh začíná rozhovorem.</h2>
				<p>Mrkni na mou cestu, nebo se začti do toho, co mi právě běží hlavou.</p>
				<a class="text-link" href="/about/">Více o mně <span aria-hidden="true">→</span></a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home { width: min(100% - 3rem, 1060px); max-width: none; padding: 0 0 5rem; }
	.intro { padding: clamp(5rem, 12vw, 9rem) 0 7rem; max-width: 800px; }
	.eyebrow { margin: 0 0 1.3rem; color: #a05e39; font-size: .72rem; font-weight: 700; letter-spacing: .16em; }
	h1 { margin: 0; font-size: clamp(3rem, 8vw, 6.8rem); line-height: .99; letter-spacing: -.065em; }
	h1 span { color: #a05e39; }
	.lead { max-width: 610px; margin: 2rem 0 0; color: #59615d; font-size: clamp(1.1rem, 2vw, 1.35rem); line-height: 1.65; }
	.actions { display: flex; align-items: center; gap: 2rem; flex-wrap: wrap; margin-top: 2.4rem; }
	.button { display: inline-flex; align-items: center; gap: 1.2rem; padding: .9rem 1.3rem; border-radius: 3px; text-decoration: none; font-weight: 700; }
	.primary { color: #fff; background: #243b35; }
	.primary:hover { color: #fff; background: #36564d; }
	.text-link { color: #243b35; font-weight: 700; text-decoration-thickness: 1px; text-underline-offset: .25em; }
	.focus { padding: 4rem 0 5rem; border-top: 1px solid #d9ddd7; }
	.focus-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
	.focus-heading .eyebrow { margin: 0; }
	.focus h2, .closing h2 { margin: 0; font-size: clamp(1.8rem, 4vw, 2.8rem); letter-spacing: -.04em; }
	.cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; margin-top: 2.6rem; }
	.card { min-height: 205px; padding: 1.5rem; border: 1px solid #d9ddd7; background: rgba(255,255,255,.55); }
	.card-number { color: #a05e39; font-size: .75rem; font-weight: 700; letter-spacing: .12em; }
	.card h3 { margin: 1.8rem 0 .6rem; font-size: 1.25rem; }
	.card p, .closing > p:not(.eyebrow) { margin: 0; color: #59615d; font-size: 1rem; line-height: 1.65; }
	.closing { padding: 3rem; background: #e9ece6; }
	.closing h2 { max-width: 650px; }
	.closing > p:not(.eyebrow) { margin: .9rem 0 1.4rem; }
	@media (max-width: 680px) {
		.home { width: min(100% - 2rem, 1060px); padding-bottom: 3rem; }
		.intro { padding: 5rem 0 5rem; }
		.focus-heading { display: block; }
		.focus-heading .eyebrow { margin-bottom: .8rem; }
		.cards { grid-template-columns: 1fr; gap: .8rem; }
		.card { min-height: auto; }
		.card h3 { margin-top: 1rem; }
		.closing { padding: 2rem 1.4rem; }
	}
</style>
