---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const email = 'rosta.slechta@gmail.com';
const mailSubject = encodeURIComponent('Probrat testování');

const principles = [
	{
		title: 'Testování v kontextu celého systému',
		text: 'Nejen jednotlivé obrazovky nebo endpointy. Zajímá mě, jak se části skládají a kde se předpoklady rozcházejí s realitou.',
	},
	{
		title: 'Návaznost dat a integrace',
		text: 'Chyby často vznikají na hranicích. Proto sleduju cestu dat mezi systémy, ne jen HTTP status.',
	},
	{
		title: 'Automatizace s opakovatelnou hodnotou',
		text: 'Automatizuju to, co má smysl hlídat znovu a znovu. Ne všechno, co jde napsat.',
	},
];

const areas = [
	{
		title: 'Funkční testování webových aplikací',
		text: 'Frontend i backend. Validace chování, stavů, oprávnění a toku dat. Od kliknutí po odpověď serveru.',
		example: 'Tlačítko je zelené, ale backend ti tiše odmítne požadavek, který UI ani nezobrazí.',
	},
	{
		title: 'API testing — REST a SOAP',
		text: 'Kontakty, kontrakty, chybové stavy a obsah odpovědí. HTTP 200 není důkaz, že data dávají smysl.',
		example: 'API může vracet 200 a přesto předat přesně ten problém, který nechceš.',
	},
	{
		title: 'Integrační testování a návaznost dat',
		text: 'Scénáře přes více systémů. Kde se data mění, ztrácejí nebo se systémy přestanou „znát“.',
		example: 'Když se dva systémy domluví, je to integrace. Když se domluví správně, je to důvod k oslavě.',
	},
	{
		title: 'Automatizované testy — Playwright a Mocha',
		text: 'Stabilní E2E a API automatizace, která běží v pipeline a dává srozumitelný signál, ne šum.',
		example: 'Zelená pipeline je příjemná. Důležité je, co vlastně ověřila.',
	},
	{
		title: 'CI/CD pipeline a validace buildů',
		text: 'Testy uvnitř procesu, ne až „až bude čas na QA“. Build, artefakty, návaznosti, regrese.',
		example: 'Pipeline, která křičí hned, když se něco rozbije — ne až po releasu.',
	},
	{
		title: 'Java / .NET SDK a integrační scénáře',
		text: 'Klientské knihovny, edge case a to, co vypadá jako detail, ale umí shodit celou integraci.',
		example: 'SDK, které „funguje u mě“, ale v produkčním toku ti tichounce ztratí jednu vazbu.',
	},
];

const steps = [
	{
		num: '01',
		title: 'Pochopit systém a očekávané chování',
		text: 'Co to dělá, pro koho a kde to bolí, když to nefunguje. Bez toho jsou testy jen checklist.',
	},
	{
		num: '02',
		title: 'Identifikovat riziková místa',
		text: 'Scénáře podle dopadu a pravděpodobnosti. Ne „otestovat všechno“ — otestovat to, co může ublížit.',
	},
	{
		num: '03',
		title: 'Ověřit funkčnost, integrace a data',
		text: 'Manuálně i automatizovaně. Sledovat cestu požadavku i to, co se s daty stane dál.',
	},
	{
		num: '04',
		title: 'Vybrat vhodné scénáře pro automatizaci',
		text: 'To, co se opakuje a má hodnotu hlídat. Automatizace nenahrazuje pochopení systému.',
	},
	{
		num: '05',
		title: 'Opakovaně ověřovat při změnách',
		text: 'Regrese s cílem vědět, v jakém stavu aplikace je — a snížit šanci, že první najde chybu zákazník.',
	},
];
---

<!doctype html>
<html lang="cs">
	<head>
		<BaseHead
			title="Rosta Šlechta | Softwarové testování, API a integrace"
			description="Softwarové testování webových aplikací, API, integrací a CI/CD. Praktický přístup k funkčnosti, návaznosti dat a automatizaci testů. Bez zbytečného divadla."
		/>
	</head>
	<body>
		<Header />
		<main>
			<!-- HERO -->
			<section class="hero" id="uvod" aria-labelledby="hero-title">
				<div class="hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">SOFTWARE TESTING. BEZ DIVADLA.</p>
						<h1 id="hero-title">Software má fungovat. I když se systémy přestanou tvářit, že se znají.</h1>
						<p class="intro">
							Jsem Rosta. Testuju webové aplikace, API, integrace a CI/CD. Od kliknutí na tlačítko až po zprávu, která se někde cestou rozhodla zmizet.
						</p>
						<p class="claim">Protože „u mě to funguje“ není testovací strategie.</p>
						<div class="actions">
							<a class="btn btn-primary" href={`mailto:${email}?subject=${mailSubject}`}>
								Probrat testování
								<span aria-hidden="true">→</span>
							</a>
							<a class="btn btn-ghost" href="#co-testuju">Co testuju</a>
						</div>
					</div>

					<div class="hero-panel" aria-hidden="true">
						<div class="panel-header">
							<span class="panel-dot panel-dot-fail"></span>
							<span class="panel-dot panel-dot-warn"></span>
							<span class="panel-dot panel-dot-ok"></span>
							<span class="panel-label">test run · integration</span>
						</div>
						<div class="panel-body">
							<div class="flow-step">
								<span class="flow-badge">UI</span>
								<span class="flow-text">klik · formulář · validace</span>
								<span class="flow-status ok">pass</span>
							</div>
							<div class="flow-connector"></div>
							<div class="flow-step">
								<span class="flow-badge">API</span>
								<span class="flow-text">POST /orders · 200 OK</span>
								<span class="flow-status ok">pass</span>
							</div>
							<div class="flow-connector"></div>
							<div class="flow-step highlight">
								<span class="flow-badge">DATA</span>
								<span class="flow-text">payload → systém B</span>
								<span class="flow-status fail">mismatch</span>
							</div>
							<div class="flow-connector"></div>
							<div class="flow-step">
								<span class="flow-badge">SDK</span>
								<span class="flow-text">klientská knihovna</span>
								<span class="flow-status skip">skipped</span>
							</div>
						</div>
						<div class="panel-footer">
							<span class="panel-meta">3/4 passed</span>
							<span class="panel-meta accent">1 data contract failed</span>
						</div>
					</div>
				</div>
			</section>

			<!-- VALUE -->
			<section class="section value" id="hodnota" aria-labelledby="value-title">
				<div class="section-inner">
					<div class="value-intro">
						<p class="eyebrow light">PROČ TO DĚLÁM</p>
						<h2 id="value-title">Nejde o to mít co nejvíc testů.</h2>
						<p class="lead">
							Jde o to vědět, co se může pokazit, kde to poznáme a jak zabránit tomu, aby se stejný problém vrátil.
						</p>
					</div>
					<div class="principle-grid">
						{principles.map((p, i) => (
							<article class="principle-card">
								<span class="principle-num">{String(i + 1).padStart(2, '0')}</span>
								<h3>{p.title}</h3>
								<p>{p.text}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<!-- AREAS / SERVICES -->
			<section class="section areas" id="co-testuju" aria-labelledby="areas-title">
				<div class="section-inner">
					<div class="section-heading">
						<p class="eyebrow light">CO TESTUJU</p>
						<h2 id="areas-title">Od tlačítka až po to, co se stane s daty dál.</h2>
						<p class="section-desc">
							Jednotlivé oblasti na sebe navazují. Cílem není sedm izolovaných služeb, ale důvěra v chování celého systému.
						</p>
					</div>
					<div class="area-grid">
						{areas.map((a) => (
							<article class="area-card">
								<div class="area-mark" aria-hidden="true"></div>
								<h3>{a.title}</h3>
								<p>{a.text}</p>
								<p class="area-example">
									<span class="example-label">Příklad</span>
									{a.example}
								</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<!-- HOW I WORK -->
			<section class="section approach" id="jak-pracuju" aria-labelledby="approach-title">
				<div class="section-inner approach-grid">
					<div class="approach-intro">
						<p class="eyebrow">JAK PRACUJU</p>
						<h2 id="approach-title">Neautomatizuju všechno.</h2>
						<p class="lead-dark">
							Automatizuju to, co má smysl hlídat opakovaně. Počet testů sám o sobě není měřítkem kvality — a automatizace nenahrazuje pochopení systému.
						</p>
					</div>
					<ol class="steps">
						{steps.map((s) => (
							<li>
								<span class="step-num">{s.num}</span>
								<div>
									<h3>{s.title}</h3>
									<p>{s.text}</p>
								</div>
							</li>
						))}
					</ol>
				</div>
			</section>

			<!-- ABOUT -->
			<section class="section about" id="o-mne" aria-labelledby="about-title">
				<div class="section-inner about-inner">
					<p class="eyebrow light">O MNĚ</p>
					<h2 id="about-title">Rosta Šlechta</h2>
					<div class="about-copy">
						<p>
							Baví mě hledat místa, kde se předpoklady systému potkávají s realitou. Obvykle to bývá zajímavější než samotné tlačítko, na které se kliká.
						</p>
						<p>
							Pohybuju se v technických detailech webových aplikací, API a integrací. Zajímá mě chování systému jako celku — a to, že problémy často vznikají na hranicích mezi komponentami, ne uprostřed jedné obrazovky.
						</p>
						<p>
							Komunikuju srozumitelně s vývojem. Cíl není jen najít chybu, ale ji spolehlivě reprodukovat, pochopit dopad a ověřit, že oprava opravdu opravila.
						</p>
						<p class="about-punch">
							„U mě to funguje“ není testovací strategie. A zelená pipeline je příjemná — důležité je, co vlastně ověřila.
						</p>
					</div>
				</div>
			</section>

			<!-- CTA -->
			<section class="section contact" id="kontakt" aria-labelledby="contact-title">
				<div class="contact-inner">
					<div class="contact-copy">
						<p class="eyebrow">KONTAKT</p>
						<h2 id="contact-title">Máte systém, kterému chcete víc věřit?</h2>
						<p>
							Pojďme se podívat, co testovat, kde hledat rizika a co má smysl automatizovat. Bez zbytečného divadla.
						</p>
					</div>
					<a class="btn btn-primary btn-lg" href={`mailto:${email}?subject=${mailSubject}`}>
						Ozvat se Rostovi
						<span aria-hidden="true">→</span>
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	/* ---------- shared ---------- */
	.section {
		scroll-margin-top: 4.5rem;
	}

	.section-inner {
		width: min(100% - 2.5rem, 1120px);
		margin: 0 auto;
	}

	.eyebrow {
		margin: 0 0 0.85rem;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.eyebrow.light {
		color: var(--accent);
	}

	.lead {
		max-width: 36rem;
		margin: 1rem 0 0;
		color: var(--text-secondary-dark);
		font-size: 1.05rem;
		line-height: 1.7;
	}

	.lead-dark {
		max-width: 28rem;
		margin: 1rem 0 0;
		color: var(--text-muted-light);
		font-size: 1.05rem;
		line-height: 1.7;
	}

	.section-desc {
		max-width: 38rem;
		margin: 1rem 0 0;
		color: var(--text-secondary-dark);
		font-size: 1rem;
		line-height: 1.7;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
		padding: 0.8rem 1.35rem;
		border: 1px solid transparent;
		border-radius: 999px;
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: none;
		transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease, filter 0.15s ease;
		cursor: pointer;
	}

	.btn:hover {
		transform: translateY(-1px);
	}

	.btn-primary {
		background: var(--accent);
		color: var(--bg);
	}

	.btn-primary:hover {
		filter: brightness(1.06);
		color: var(--bg);
	}

	.btn-ghost {
		border-color: rgba(244, 247, 242, 0.28);
		color: var(--text-on-dark);
		background: transparent;
	}

	.btn-ghost:hover {
		border-color: var(--accent);
		color: var(--text-on-dark);
	}

	.btn-lg {
		padding: 0.95rem 1.6rem;
		font-size: 0.95rem;
	}

	/* ---------- HERO ---------- */
	.hero {
		position: relative;
		padding: clamp(3.5rem, 8vw, 6rem) 0 clamp(4rem, 9vw, 7rem);
		background:
			radial-gradient(ellipse 80% 60% at 70% 20%, rgba(184, 243, 107, 0.07), transparent 55%),
			var(--bg);
		overflow: hidden;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
		align-items: center;
		gap: clamp(2rem, 5vw, 4rem);
		width: min(100% - 2.5rem, 1120px);
		margin: 0 auto;
	}

	.hero-copy h1 {
		max-width: 18ch;
		margin: 0;
		color: var(--text-on-dark);
		font-size: clamp(2.15rem, 4.2vw, 3.15rem);
		line-height: 1.12;
	}

	.intro {
		max-width: 36rem;
		margin: 1.35rem 0 0;
		color: var(--text-secondary-dark);
		font-size: 1.05rem;
		line-height: 1.7;
	}

	.claim {
		margin: 1.15rem 0 0;
		color: var(--accent);
		font-size: 0.95rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	/* Hero technical panel */
	.hero-panel {
		background: var(--surface);
		border: 1px solid var(--line-dark);
		border-radius: 12px;
		overflow: hidden;
		box-shadow: var(--shadow);
		font-family: ui-monospace, "SF Mono", "Cascadia Code", Menlo, monospace;
		font-size: 0.78rem;
	}

	.panel-header {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.7rem 1rem;
		background: var(--surface-2);
		border-bottom: 1px solid var(--line-dark);
	}

	.panel-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
	}

	.panel-dot-fail { background: #e85d5d; }
	.panel-dot-warn { background: #e8c45d; }
	.panel-dot-ok { background: var(--accent); }

	.panel-label {
		margin-left: 0.5rem;
		color: var(--text-secondary-dark);
		letter-spacing: 0.04em;
	}

	.panel-body {
		padding: 1.1rem 1rem;
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.flow-step {
		display: grid;
		grid-template-columns: 3.2rem 1fr auto;
		align-items: center;
		gap: 0.65rem;
		padding: 0.55rem 0.65rem;
		border-radius: 6px;
		background: rgba(0, 0, 0, 0.18);
	}

	.flow-step.highlight {
		background: rgba(232, 93, 93, 0.12);
		outline: 1px solid rgba(232, 93, 93, 0.35);
	}

	.flow-badge {
		font-weight: 700;
		font-size: 0.68rem;
		letter-spacing: 0.06em;
		color: var(--accent);
	}

	.flow-text {
		color: var(--text-secondary-dark);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.flow-status {
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.flow-status.ok { color: var(--accent); }
	.flow-status.fail { color: #e85d5d; }
	.flow-status.skip { color: var(--text-secondary-dark); opacity: 0.7; }

	.flow-connector {
		width: 1px;
		height: 12px;
		margin-left: 1.9rem;
		background: var(--line-dark);
	}

	.panel-footer {
		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.65rem 1rem;
		border-top: 1px solid var(--line-dark);
		background: var(--surface-2);
	}

	.panel-meta {
		color: var(--text-secondary-dark);
		font-size: 0.7rem;
	}

	.panel-meta.accent {
		color: #e85d5d;
		font-weight: 600;
	}

	/* ---------- VALUE ---------- */
	.value {
		padding: clamp(4rem, 8vw, 6rem) 0;
		background: var(--bg);
		border-top: 1px solid var(--line-dark);
	}

	.value h2 {
		max-width: 18ch;
		color: var(--text-on-dark);
	}

	.principle-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
		margin-top: 2.5rem;
	}

	.principle-card {
		padding: 1.4rem 1.35rem;
		background: var(--surface);
		border: 1px solid var(--line-dark);
		border-radius: 10px;
		transition: border-color 0.15s ease;
	}

	.principle-card:hover {
		border-color: rgba(184, 243, 107, 0.28);
	}

	.principle-num {
		display: block;
		margin-bottom: 0.9rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		color: var(--accent);
		font-family: ui-monospace, monospace;
	}

	.principle-card h3 {
		margin: 0 0 0.55rem;
		font-size: 1.05rem;
		color: var(--text-on-dark);
	}

	.principle-card p {
		margin: 0;
		font-size: 0.9rem;
		color: var(--text-secondary-dark);
		line-height: 1.65;
	}

	/* ---------- AREAS ---------- */
	.areas {
		padding: clamp(4rem, 8vw, 6rem) 0;
		background: var(--surface);
		border-top: 1px solid var(--line-dark);
	}

	.areas h2 {
		color: var(--text-on-dark);
		max-width: 22ch;
	}

	.area-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
		margin-top: 2.5rem;
	}

	.area-card {
		padding: 1.5rem 1.4rem;
		background: var(--bg);
		border: 1px solid var(--line-dark);
		border-radius: 10px;
		transition: border-color 0.15s ease, transform 0.15s ease;
	}

	.area-card:hover {
		border-color: rgba(184, 243, 107, 0.25);
		transform: translateY(-2px);
	}

	.area-mark {
		width: 2rem;
		height: 3px;
		border-radius: 999px;
		background: var(--accent);
		margin-bottom: 1.15rem;
	}

	.area-card h3 {
		margin: 0 0 0.6rem;
		font-size: 1.1rem;
		color: var(--text-on-dark);
	}

	.area-card > p {
		margin: 0 0 1rem;
		font-size: 0.9rem;
		color: var(--text-secondary-dark);
		line-height: 1.65;
	}

	.area-example {
		margin: 0 !important;
		padding-top: 0.9rem;
		border-top: 1px solid var(--line-dark);
		font-size: 0.82rem !important;
		color: var(--text-secondary-dark) !important;
		line-height: 1.55 !important;
		font-style: italic;
	}

	.example-label {
		display: block;
		margin-bottom: 0.25rem;
		font-style: normal;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
	}

	/* ---------- APPROACH ---------- */
	.approach {
		padding: clamp(4rem, 8vw, 6rem) 0;
		background: var(--light-bg);
		color: var(--text-on-light);
	}

	.approach .eyebrow {
		color: var(--text-muted-light);
	}

	.approach h2 {
		color: var(--text-on-light);
		max-width: 14ch;
	}

	.approach-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: clamp(2rem, 6vw, 4.5rem);
		align-items: start;
	}

	.steps {
		list-style: none;
		margin: 0;
		padding: 0;
