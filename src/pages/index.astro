---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const email = 'rosta.slechta@gmail.com';
const mailSubject = encodeURIComponent('Spolupráce v testování');

const services = [
	['01', 'Analýza a návrh testů', 'Projdu požadavky, identifikuji důležité scénáře a připravím testovací analýzu, strategii a sadu testovacích scénářů.'],
	['02', 'Manuální a funkční testování', 'Ověřím chování aplikace, práci s daty, chybové stavy i návaznosti mezi jednotlivými funkcemi.'],
	['03', 'Automatizované testování', 'Připravím nebo rozšířím automatizované testy pro opakované ověřování funkčnosti a regresní testování.'],
	['04', 'Exekuce a vyhodnocení testů', 'Provedu testy, zaznamenám zjištěné problémy a připravím přehled výsledků včetně informací potřebných k jejich řešení.'],
];

const areas = [
	['Webové aplikace — FE a BE', 'Testování frontendové i backendové části, funkcionality, validací, práce s daty a návazností mezi komponentami. Funkční, integrační, regresní a end-to-end testy.'],
	['CI/CD pipeline', 'Ověřování procesů buildu, validací, generování a publikace artefaktů. Testování chybových stavů a návazností mezi jednotlivými kroky automatizovaného procesu.'],
	['API — REST a SOAP', 'Ověřování API, requestů a response, datových struktur, validací, chybových odpovědí a komunikace mezi systémy.'],
	['Java a .NET SDK', 'Testování klientských knihoven a integračních řešení, včetně REST/SOAP komunikace, zpracování chyb a návazností na další systémy.'],
];

const steps = [
	['01', 'Pochopení požadavků', 'Seznámím se s řešením, jeho funkcionalitou a očekávaným chováním.'],
	['02', 'Návrh testovacího přístupu', 'Připravím scénáře podle rizik, důležitosti funkcionality a potřeb projektu.'],
	['03', 'Provedení testů', 'Kombinuji manuální a automatizované testování podle toho, co je pro danou oblast nejvhodnější.'],
	['04', 'Vyhodnocení a ověření oprav', 'Zdokumentuji výsledky, pomohu s reprodukcí chyb a ověřím, že provedené změny fungují správně.'],
];
---

<!doctype html>
<html lang="cs">
	<head>
		<BaseHead title="Rostislav Šlechta | Software Tester" description="Software testing pro webové aplikace, API, Java/.NET SDK a CI/CD pipeline." />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero" id="uvod" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow">ROSTISLAV ŠLECHTA · SOFTWARE TESTER</p>
					<h1 id="hero-title">Software testing, který pomáhá předcházet chybám.</h1>
					<p class="intro">Pomáhám ověřit, že váš software funguje tak, jak má. Od analýzy požadavků a návrhu testovacích scénářů přes manuální testování až po automatizované testy, které pomáhají udržet kvalitu i při dalších změnách.</p>
					<p class="scope">Webové aplikace · API · Java/.NET SDK · CI/CD pipeline</p>
					<div class="actions"><a class="button button-primary" href={`mailto:${email}?subject=${mailSubject}`}>Probrat možnosti spolupráce <span aria-hidden="true">→</span></a><a class="button button-secondary" href="#oblasti">Oblasti testování</a></div>
				</div>
				<aside class="hero-note" aria-label="Co mohu pomoci ověřit">
					<p>TESTOVÁNÍ SE ZAMĚŘENÍM NA</p>
					<ul><li>funkčnost a chybové stavy</li><li>integrace a datové návaznosti</li><li>opakované ověření změn</li></ul>
				</aside>
			</section>

			<section class="section services" id="sluzby" aria-labelledby="services-title">
				<div class="section-heading"><p class="eyebrow">CO PRO VÁS ZAJISTÍM</p><h2 id="services-title">Testování od prvního scénáře až po automatizaci.</h2><p>Každý projekt potřebuje jiný rozsah testování. Pomohu určit, co je potřeba ověřit, připravit vhodné testovací scénáře a provést testy tak, aby jejich výsledky přinesly konkrétní informace o kvalitě řešení.</p></div>
				<div class="service-grid">{services.map(([number, title, text]) => <article class="service-card"><span>{number}</span><h3>{title}</h3><p>{text}</p></article>)}</div>
			</section>

			<section class="section areas" id="oblasti" aria-labelledby="areas-title">
				<div class="section-heading"><p class="eyebrow">OBLASTI TESTOVÁNÍ</p><h2 id="areas-title">Od uživatelského rozhraní až po integrace.</h2></div>
				<div class="area-grid">{areas.map(([title, text]) => <article class="area-card"><div class="card-mark" aria-hidden="true"></div><h3>{title}</h3><p>{text}</p></article>)}</div>
			</section>

			<section class="section approach" id="pristup" aria-labelledby="approach-title">
				<div class="section-heading"><p class="eyebrow">JAK PRACUJI</p><h2 id="approach-title">Testování musí dávat smysl, ne jen generovat reporty.</h2><p>Nejde o to otestovat všechno za každou cenu. Důležité je pochopit, co aplikace dělá, kde může selhat a které scénáře mají největší význam.</p></div>
				<ol class="steps">{steps.map(([number, title, text]) => <li><span>{number}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol>
				<p class="outcome">Cílem je mít přehled o skutečném stavu aplikace a snížit riziko, že se problém projeví až po nasazení.</p>
			</section>

			<section class="section about" id="o-mne" aria-labelledby="about-title">
				<div class="section-heading"><p class="eyebrow">O MNĚ</p><h2 id="about-title">Rostislav Šlechta — Test Engineer</h2></div>
				<div class="about-copy"><p>Věnuji se testování softwaru v bankovním prostředí, kde se setkávají webové aplikace, API, integrační řešení a automatizované vývojové procesy.</p><p>Mám zkušenosti s návrhem testovacích scénářů, manuálním ověřováním funkcionality, automatizovanými testy i testováním komplexních návazností mezi systémy.</p><p>Při práci využívám nástroje jako Playwright, Mocha, Postman a JMeter. Zaměřuji se také na testování Java a .NET SDK a na ověřování funkčnosti CI/CD pipeline.</p><p><strong>Důležité je pro mě nejen chybu najít, ale také ji spolehlivě reprodukovat, srozumitelně popsat a ověřit její odstranění.</strong></p></div>
			</section>

			<section class="contact" id="kontakt" aria-labelledby="contact-title">
				<div><p class="eyebrow">KONTAKT</p><h2 id="contact-title">Potřebujete do vývoje zapojit testování?</h2><p>Ať už potřebujete otestovat novou funkcionalitu, připravit automatizované testy nebo získat lepší přehled o kvalitě svého řešení, můžeme probrat, co váš projekt potřebuje.</p></div>
				<a class="button button-dark" href={`mailto:${email}?subject=${mailSubject}`}>Kontaktovat Rostislava <span aria-hidden="true">→</span></a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main { width: min(100% - 3rem, 1120px); max-width: none; padding: 0 0 5rem; }
	.hero { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(280px, .65fr); align-items: center; gap: clamp(3rem, 8vw, 8rem); min-height: 690px; padding: clamp(5rem, 11vw, 9rem) 0; }
	.eyebrow { margin: 0 0 .9rem; color: var(--accent); font-size: .7rem; font-weight: 700; letter-spacing: .14em; }
	h1, h2 { letter-spacing: -.055em; } h1 { max-width: 780px; margin: 0; font-size: clamp(3rem, 6.6vw, 6rem); } h2 { max-width: 790px; margin: 0; font-size: clamp(2rem, 4.2vw, 3.5rem); }
	.intro { max-width: 670px; margin: 1.5rem 0 0; color: var(--muted); font-size: clamp(1.08rem, 2vw, 1.28rem); line-height: 1.7; }.scope { margin: 1.4rem 0 0; color: #d4e4df; font-size: .84rem; font-weight: 700; letter-spacing: .02em; }
	.actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2.25rem; }.button { display: inline-flex; align-items: center; justify-content: center; gap: .8rem; padding: .85rem 1.15rem; border: 1px solid transparent; border-radius: 6px; font-size: .9rem; font-weight: 700; text-decoration: none; transition: background .16s ease, border-color .16s ease, transform .16s ease; }.button:hover { transform: translateY(-1px); }.button-primary { color: #062019; background: var(--accent); }.button-primary:hover { color: #062019; background: var(--accent-strong); }.button-secondary { border-color: var(--line); color: var(--paper); background: transparent; }.button-secondary:hover { border-color: var(--accent); color: var(--paper); }
	.hero-note { padding: 1.5rem; border: 1px solid var(--line); border-radius: 8px; background: rgba(16, 36, 49, .72); }.hero-note > p { margin: 0 0 1rem; color: var(--accent); font-size: .66rem; font-weight: 700; letter-spacing: .12em; }.hero-note ul { display: grid; gap: .85rem; padding: 0; margin: 0; list-style: none; }.hero-note li { padding-top: .85rem; border-top: 1px solid var(--line); color: #d8e7e3; font-size: .9rem; }.hero-note li::before { margin-right: .65rem; color: var(--accent); content: '✓'; }
	.section { padding: 6rem 0; border-top: 1px solid var(--line); scroll-margin-top: 2rem; }.section-heading > p:last-child { max-width: 690px; margin: 1rem 0 0; color: var(--muted); font-size: 1rem; line-height: 1.7; }.service-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-top: 2.5rem; }.service-card { padding: 1.35rem; border: 1px solid var(--line); border-radius: 8px; background: rgba(16, 36, 49, .44); }.service-card > span { color: var(--accent); font-size: .7rem; font-weight: 700; letter-spacing: .1em; }.service-card h3, .area-card h3, .steps h3 { margin: 1.6rem 0 .55rem; font-size: 1.18rem; letter-spacing: -.025em; }.service-card p, .area-card p, .steps p { margin: 0; color: var(--muted); font-size: .88rem; line-height: 1.65; }
	.area-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-top: 2.5rem; }.area-card { min-height: 220px; padding: 1.5rem; border: 1px solid var(--line); border-radius: 8px; background: rgba(16, 36, 49, .44); }.card-mark { width: 2.2rem; height: .3rem; border-radius: 999px; background: var(--accent); }.area-card:nth-child(2) .card-mark { background: var(--violet); }.area-card:nth-child(3) .card-mark { background: var(--coral); }.area-card:nth-child(4) .card-mark { background: #8bc8ff; }.area-card h3 { margin-top: 1.5rem; }
	.approach { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(2rem, 7vw, 7rem); align-items: start; }.steps { display: grid; gap: 1rem; padding: 0; margin: 0; list-style: none; }.steps li { display: grid; grid-template-columns: 2.4rem 1fr; gap: 1rem; padding-bottom: 1.1rem; border-bottom: 1px solid var(--line); }.steps li > span { color: var(--accent); font-size: .72rem; font-weight: 700; }.steps h3 { margin: 0 0 .35rem; }.outcome { grid-column: 2; max-width: 630px; margin: 0; padding: 1.1rem 0 0; color: #d7e7e3; font-size: .95rem; font-weight: 700; line-height: 1.65; }
	.about { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(2rem, 7vw, 7rem); }.about-copy { max-width: 670px; }.about-copy p { margin: 0 0 1.1rem; color: var(--muted); line-height: 1.7; }.about-copy strong { color: var(--paper); }
	.contact { display: flex; align-items: end; justify-content: space-between; gap: 2rem; padding: clamp(2rem, 5vw, 4rem); border-radius: 8px; color: #09231d; background: var(--accent); scroll-margin-top: 2rem; }.contact .eyebrow { color: #276653; }.contact h2 { color: #09231d; }.contact p:last-child { max-width: 680px; margin: 1rem 0 0; color: #245e4d; line-height: 1.65; }.button-dark { flex: 0 0 auto; color: var(--paper); background: #0b2631; }.button-dark:hover { color: var(--paper); background: #173d4b; }
	@media (max-width: 880px) { .hero, .approach, .about { grid-template-columns: 1fr; }.hero { min-height: 0; }.hero-note { max-width: 500px; }.service-grid { grid-template-columns: repeat(2, 1fr); }.outcome { grid-column: auto; }.about { gap: 1rem; } }
	@media (max-width: 620px) { main { width: min(100% - 2rem, 1120px); }.hero { padding: 4.5rem 0; }.section { padding: 4rem 0; }.service-grid, .area-grid { grid-template-columns: 1fr; }.contact { align-items: flex-start; flex-direction: column; }.button-dark { width: 100%; }.scope { line-height: 1.8; } }
</style>
