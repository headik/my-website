---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
import logo from '../assets/rosta-brand-mark.png';
---

<header>
	<nav aria-label="Hlavní navigace">
		<a class="brand" href="/" aria-label={`${SITE_TITLE} – úvodní stránka`}>
			<span class="brand-mark">
				<img src={logo.src} alt="" width="48" height="38" />
			</span>
			<span class="brand-text">
				<span class="brand-name">Rosta Šlechta</span>
				<span class="brand-tag">Software testing</span>
			</span>
		</a>
		<div class="internal-links" id="nav-links">
			<HeaderLink href="#co-testuju">Co testuju</HeaderLink>
			<HeaderLink href="#jak-pracuju">Jak pracuju</HeaderLink>
			<HeaderLink href="#o-mne">O mně</HeaderLink>
			<a class="nav-cta" href="#kontakt">Kontakt</a>
		</div>
		<button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="Otevřít menu">
			<span class="nav-toggle-bar"></span>
			<span class="nav-toggle-bar"></span>
		</button>
	</nav>
</header>

<script>
	const toggle = document.querySelector('.nav-toggle');
	const links = document.getElementById('nav-links');
	if (toggle && links) {
		toggle.addEventListener('click', () => {
			const open = toggle.getAttribute('aria-expanded') === 'true';
			toggle.setAttribute('aria-expanded', String(!open));
			links.classList.toggle('is-open', !open);
		});
		links.querySelectorAll('a').forEach((a) => {
			a.addEventListener('click', () => {
				toggle.setAttribute('aria-expanded', 'false');
				links.classList.remove('is-open');
			});
		});
	}
</script>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		padding: 0 1.25rem;
		border-bottom: 1px solid var(--line-dark);
		background: rgba(16, 23, 19, 0.92);
		backdrop-filter: blur(12px);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1120px;
		margin: 0 auto;
		min-height: 64px;
		gap: 1rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		text-decoration: none;
		color: var(--text-on-dark);
		flex-shrink: 0;
	}

	.brand-mark {
		display: flex;
		width: 48px;
		height: 38px;
		align-items: center;
	}

	.brand-mark img {
		width: 48px;
		height: auto;
		border-radius: 0;
	}

	.brand-text {
		display: flex;
		flex-direction: column;
		line-height: 1.15;
	}

	.brand-name {
		font-size: 0.95rem;
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.brand-tag {
		font-size: 0.68rem;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-secondary-dark);
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.15rem;
	}

	.internal-links :global(a) {
		display: flex;
		align-items: center;
		height: 42px;
		padding: 0 0.75rem;
		color: var(--text-secondary-dark);
		text-decoration: none;
		font-size: 0.875rem;
		font-weight: 500;
		border-bottom: 2px solid transparent;
		transition: color 0.15s ease, border-color 0.15s ease;
	}

	.internal-links :global(a:hover),
	.internal-links :global(a.active) {
		color: var(--text-on-dark);
		border-bottom-color: var(--accent);
	}

	.nav-cta {
		display: inline-flex !important;
		align-items: center;
		justify-content: center;
		height: 38px !important;
		margin-left: 0.5rem;
		padding: 0 1.1rem !important;
		border: none !important;
		border-radius: 999px;
		background: var(--accent);
		color: var(--bg) !important;
		font-weight: 700 !important;
		font-size: 0.85rem !important;
		transition: filter 0.15s ease, transform 0.15s ease;
	}

	.nav-cta:hover {
		filter: brightness(1.05);
		transform: translateY(-1px);
		border-bottom-color: transparent !important;
	}

	.nav-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 40px;
		height: 40px;
		padding: 0;
		border: 1px solid var(--line-dark);
		border-radius: 8px;
		background: transparent;
		cursor: pointer;
	}

	.nav-toggle-bar {
		display: block;
		width: 18px;
		height: 2px;
		margin: 0 auto;
		background: var(--text-on-dark);
		border-radius: 1px;
		transition: transform 0.2s ease, opacity 0.2s ease;
	}

	.nav-toggle[aria-expanded="true"] .nav-toggle-bar:first-child {
		transform: translateY(3.5px) rotate(45deg);
	}

	.nav-toggle[aria-expanded="true"] .nav-toggle-bar:last-child {
		transform: translateY(-3.5px) rotate(-45deg);
	}

	@media (max-width: 720px) {
		.nav-toggle { display: flex; }

		.internal-links {
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			padding: 0.75rem 1.25rem 1.25rem;
			background: var(--surface);
			border-bottom: 1px solid var(--line-dark);
			gap: 0.25rem;
			display: none;
		}

		.internal-links.is-open { display: flex; }

		.internal-links :global(a) {
			height: 44px;
			padding: 0 0.5rem;
			border-bottom: none;
			border-radius: 8px;
		}

		.internal-links :global(a:hover) {
			background: var(--accent-soft);
		}

		.nav-cta {
			margin: 0.5rem 0 0 !important;
			height: 44px !important;
			width: 100%;
			justify-content: center;
		}
	}
</style>
