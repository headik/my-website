---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav aria-label="Hlavní navigace">
		<h2><a href="/">{SITE_TITLE}<span aria-hidden="true">.</span></a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Úvod</HeaderLink>
			<HeaderLink href="/sluzby/">Služby</HeaderLink>
			<HeaderLink href="/reference/">Zkušenosti</HeaderLink>
			<HeaderLink href="/about/">O mně</HeaderLink>
			<HeaderLink href="/kontakt/">Kontakt</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header { padding: 0 1.5rem; background: rgba(250, 250, 247, .92); border-bottom: 1px solid #e2e4df; }
	nav { display: flex; align-items: center; justify-content: space-between; max-width: 1060px; margin: 0 auto; }
	h2 { margin: 0; font-size: 1.15rem; letter-spacing: -.04em; }
	h2 a { color: #243b35; text-decoration: none; }
	h2 span { color: #a05e39; }
	.internal-links { display: flex; gap: .15rem; }
	nav :global(a) { padding: 1rem .7rem; color: #34413c; text-decoration: none; border-bottom: 2px solid transparent; font-size: .95rem; }
	nav :global(a.active) { border-bottom-color: #a05e39; }
	@media (max-width: 680px) { header { padding: 0 1rem; } nav { align-items: flex-start; flex-direction: column; } nav :global(a) { padding: .7rem .45rem; font-size: .88rem; } .internal-links { flex-wrap: wrap; margin-left: -.45rem; } }
</style>
