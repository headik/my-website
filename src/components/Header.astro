---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
import logo from '../assets/rosta-brand-mark.png';
---

<header>
	<nav aria-label="Hlavní navigace">
		<h2><a class="brand" href="/" aria-label={`${SITE_TITLE} – úvodní stránka`}><span class="brand-mark"><img src={logo.src} alt="" /></span><span class="brand-tagline">FOR<br />RELIABLE SOLUTIONS</span></a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Úvod</HeaderLink>
			<HeaderLink href="#sluzby">Služby</HeaderLink>
			<HeaderLink href="#oblasti">Oblasti</HeaderLink>
			<HeaderLink href="#pristup">Přístup</HeaderLink>
			<HeaderLink href="#kontakt">Kontakt</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header { position: sticky; z-index: 5; top: 0; padding: 0 1.5rem; border-bottom: 1px solid var(--gray-200); background: var(--white); }
	nav { display: flex; align-items: center; justify-content: space-between; max-width: 1100px; margin: 0 auto; }
	h2 { margin: 0; font-size: 1.05rem; letter-spacing: -.04em; }
	h2 .brand { display: inline-flex; align-items: flex-end; gap: .7rem; padding: .45rem 0; border: 0; color: var(--primary-dark); text-decoration: none; }
	.brand-mark { display: flex; width: 60px; height: 48px; flex: 0 0 60px; align-items: flex-end; }
	.brand-mark img { display: block; width: 60px; height: auto; max-width: none; border-radius: 0; }
	.brand-tagline { margin-bottom: 0; color: var(--primary-dark); font-size: .72rem; font-weight: 600; letter-spacing: .09em; line-height: 1.25; }
	.internal-links { display: flex; align-items: center; gap: .15rem; }
	.internal-links :global(a) { display: flex; height: 44px; box-sizing: border-box; align-items: center; justify-content: center; padding: 0 .7rem; color: var(--gray-900); text-decoration: none; border-bottom: 2px solid transparent; font-size: .88rem; line-height: 1.2; transition: color .2s ease, border-color .2s ease; }
	.internal-links :global(a:hover), .internal-links :global(a.active) { color: var(--primary-dark); border-bottom-color: var(--accent); }
	.internal-links :global(a[href="#kontakt"]) { width: auto; height: 44px; min-height: 44px; max-height: 44px; align-self: center; margin-left: .35rem; padding: 0 1rem; border: 0; border-radius: 999px; color: var(--primary-dark); background: var(--accent); font-weight: 700; }
	@media (max-width: 680px) { header { padding: 0 1rem; } nav { align-items: flex-start; flex-direction: column; } .brand-tagline { font-size: .68rem; } .internal-links :global(a) { height: 40px; padding: 0 .45rem; font-size: .82rem; } .internal-links :global(a[href="#kontakt"]) { height: 40px; min-height: 40px; max-height: 40px; padding: 0 .8rem; } .internal-links { flex-wrap: wrap; margin-left: -.45rem; } }
</style>
