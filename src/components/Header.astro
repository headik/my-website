---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav aria-label="Hlavní navigace">
		<h2><a href="/">{SITE_TITLE}<span aria-hidden="true">.</span></a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Úvod</HeaderLink>
			<HeaderLink href="#sluzby">Služby</HeaderLink>
			<HeaderLink href="#oblasti">Oblasti</HeaderLink>
			<HeaderLink href="#pristup">Přístup</HeaderLink>
			<HeaderLink href="#kontakt">Kontakt</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header { position: sticky; z-index: 5; top: 0; padding: 0 1.5rem; border-bottom: 1px solid rgba(195, 228, 220, .13); background: rgba(10, 25, 34, .94); }
	nav { display: flex; align-items: center; justify-content: space-between; max-width: 1100px; margin: 0 auto; }
	h2 { margin: 0; font-size: 1.05rem; letter-spacing: -.04em; }
	h2 a { color: #ecf7f3; text-decoration: none; }
	h2 span { color: #8bffcf; }
	.internal-links { display: flex; gap: .15rem; }
	nav :global(a) { padding: 1rem .7rem; color: #aebfc4; text-decoration: none; border-bottom: 2px solid transparent; font-size: .88rem; transition: color .2s ease, border-color .2s ease; }
	nav :global(a:hover), nav :global(a.active) { color: #ecf7f3; border-bottom-color: #8bffcf; }
	@media (max-width: 680px) { header { padding: 0 1rem; } nav { align-items: flex-start; flex-direction: column; } nav :global(a) { padding: .7rem .45rem; font-size: .82rem; } .internal-links { flex-wrap: wrap; margin-left: -.45rem; } }
</style>
