---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
import logo from '../styles/logo.png';
---

<header>
	<nav aria-label="Hlavní navigace">
		<h2><a class="brand" href="/" aria-label={`${SITE_TITLE} – úvodní stránka`}><span class="brand-mark"><img src={logo.src} alt="" /></span><span class="brand-name">{SITE_TITLE}</span></a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Úvod</HeaderLink>
			<HeaderLink href="#sluzby">Služby</HeaderLink>
			<HeaderLink href="#oblasti">Oblasti</HeaderLink>
			<HeaderLink href="#pristup">Přístup</HeaderLink>
			<HeaderLink href="#kontakt">Kontakt</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header { position: sticky; z-index: 5; top: 0; padding: 0 1.5rem; border-bottom: 1px solid rgba(195, 228, 220, .13); background: rgba(10, 25, 34, .94); }
	nav { display: flex; align-items: center; justify-content: space-between; max-width: 1100px; margin: 0 auto; }
	h2 { margin: 0; font-size: 1.05rem; letter-spacing: -.04em; }
	h2 .brand { display: inline-flex; align-items: center; gap: .7rem; padding: .45rem 0; border: 0; color: #ecf7f3; text-decoration: none; }
	.brand-mark { display: grid; width: 42px; height: 42px; flex: 0 0 42px; place-items: center; overflow: hidden; border-radius: 7px; background: #fff; }
	.brand-mark img { width: 59px; height: 59px; max-width: none; border-radius: 0; }
	.brand-name { color: #ecf7f3; }
	.internal-links { display: flex; gap: .15rem; }
	.internal-links :global(a) { padding: 1rem .7rem; color: #aebfc4; text-decoration: none; border-bottom: 2px solid transparent; font-size: .88rem; transition: color .2s ease, border-color .2s ease; }
	.internal-links :global(a:hover), .internal-links :global(a.active) { color: #ecf7f3; border-bottom-color: #8bffcf; }
	@media (max-width: 680px) { header { padding: 0 1rem; } nav { align-items: flex-start; flex-direction: column; } .internal-links :global(a) { padding: .7rem .45rem; font-size: .82rem; } .internal-links { flex-wrap: wrap; margin-left: -.45rem; } }
</style>
