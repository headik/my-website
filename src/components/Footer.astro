---
const year = new Date().getFullYear();
---

<footer>
	<p>© {year} Rostislav Šlechta <span aria-hidden="true">·</span> Testuju, než to testne produkce.</p>
	<a href="/kontakt/">Ozvat se Rostovi <span aria-hidden="true">↗</span></a>
</footer>

<style>
	footer { display: flex; justify-content: space-between; align-items: center; gap: 1rem; max-width: 1060px; margin: 0 auto; padding: 1.5rem; border-top: 1px solid #e2e4df; color: #68716c; font-size: .85rem; }
	footer p { margin: 0; }
	footer a { color: #34413c; text-decoration: none; }
	footer a:hover { text-decoration: underline; }
	@media (max-width: 480px) { footer { margin: 0 1rem; padding: 1.5rem 0; } }
</style>
