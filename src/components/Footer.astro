---
const year = new Date().getFullYear();
---

<footer>
	<p>© {year} Rostislav Šlechta <span aria-hidden="true">·</span> Test engineer</p>
	<a href="#kontakt">Kontakt <span aria-hidden="true">↑</span></a>
</footer>

<style>
	footer { display: flex; justify-content: space-between; align-items: center; gap: 1rem; max-width: 1100px; margin: 0 auto; padding: 1.7rem 1.5rem; border-top: 1px solid var(--gray-200); color: var(--gray-600); font-size: .85rem; }
	footer p { margin: 0; }
	footer a { color: var(--primary-dark); text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: .2em; }
	footer a:hover { color: var(--gray-600); }
	@media (max-width: 480px) { footer { margin: 0 1rem; padding: 1.5rem 0; } }
</style>
