	<a href="/kontakt/">Kontakt <span aria-hidden="true">↗</span></a>
</footer>

<style>
	footer { display: flex; justify-content: space-between; align-items: center; gap: 1rem; max-width: 1100px; margin: 0 auto; padding: 1.7rem 1.5rem; border-top: 1px solid rgba(195, 228, 220, .13); color: #8fa3aa; font-size: .85rem; }
	footer p { margin: 0; }
	footer a { color: #8bffcf; text-decoration: none; }
	footer a:hover { color: #fff; }
	@media (max-width: 480px) { footer { margin: 0 1rem; padding: 1.5rem 0; } }
</style>
